VITE_OPENAI_API_KEY=tu_api_key_aqui
VITE_OPENAI_MODEL=gpt-4o-mini

VITE_ANTHROPIC_API_KEY=tu_api_key_de_claude_aqui
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (modelo local, sin API key). Requiere "ollama serve" corriendo.
# Si tenés problema de CORS, arrancalo con: OLLAMA_ORIGINS=* ollama serve
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_MODEL=gemma3:4b

# LM Studio (modelo local, sin API key real). Requiere el server activo:
# LM Studio → Developer → Status: Running. El "model identifier" lo ves en la UI.
VITE_LMSTUDIO_HOST=http://localhost:1234
VITE_LMSTUDIO_MODEL=google/gemma-4-e4b
